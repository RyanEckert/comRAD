# comrad reads pipeline: run from the project folder.
# Lines are KEY = value; relative paths are taken from this folder.
# 'required' after the # means it must be filled in.

RAW = rawReads           # required: folder for the raw .fastq.gz (downloads land here)
BS_PROJECTS =            # BaseSpace projects to download into RAW, space-separated; empty = reads already in RAW
SAMPLE_SHEET =           # required: CSV for sampleRename.py: old name (pool_barcode), new sample name
RENAME_ARGS =            # extra sampleRename.py options, e.g. --header
SPECIES =                # required: species=prefix pairs, e.g. mcav=MGM ofav=OGM; samples starting with the prefix go to <species>/demuxReads
MIN_KEPT = 25            # stop if any pool keeps less than this percent of its reads (kept = after dedup)

# ---- jobs: one section per job list. cpus and mem are per job (per array task);
# queue (empty = [cluster] queue; 'long' = [cluster] long_queue) and slurm (extra
# sbatch flags, key=value) are optional in every section. In your config, args
# lists only changes to the defaults here (`comrad defaults reads`).

[download]               # fetchReads.py, one job
cpus = 1
mem = 200GB

[demux]                  # trim2bRAD.py: find the tag, deduplicate, demultiplex; one job per pool
cpus = 2
mem = 16GB
args = --gzip            # trim2bRAD.py options (e.g. --sample-id 1, --min-bc-count 50000); barcodes with < 100,000 reads get no file
