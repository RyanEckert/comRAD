# comrad cluster settings, shared by every pipeline under this folder.
# comrad looks for cluster.config in the folder it runs in and up to three
# folders above it, so one in the project folder covers every species folder.
# A [cluster] line in a pipeline's own .config overrides the same line here.
# Lines are key = value; exported variables ($EMAIL) are expanded.

[cluster]
queue =                  # partition for jobs; empty = the cluster's default partition
long_queue =             # partition for jobs that hit a time limit, and for sections with queue = long; empty = none (they stop)
max_mem = 250GB          # out-of-memory retries double a job's memory up to this; set it to your largest node's memory
max_running = 64         # array tasks running at once, per job list
email =                  # mail on failed jobs and when the pipeline ends; empty = no mail
slurm =                  # extra sbatch flags for every job, as key=value or bare flags: e.g. account=mylab constraint=amd exclusive
driver_queue =           # partition for the driver job, which runs for the whole pipeline; empty = long_queue, else queue
driver_time =            # driver time limit, e.g. 2-00:00:00 (helps it start sooner on a busy partition); empty = the partition maximum
driver_cpus = 8          # driver CPUs, used by the steps' own short work (sorting, R plots)
driver_mem = 32GB        # driver memory
local_copy = no          # yes: realSFS and thetaStat read copies of their SAF, theta and FST files on node-local disk ($TMPDIR), for file systems that give bgzf read errors on intact files (BeeGFS); needs local space for the largest SAF
