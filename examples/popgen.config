# Example popgen.config for one species folder (<project>/sint).
# Run from that folder:  comrad check popgen && comrad run popgen
# Paths may use exported variables ($koko) or be relative to this folder.
# Partitions, memory limit and email come from cluster.config in the project folder.
# Every default is listed by:  comrad defaults popgen

SP = sint                 # required: prefix for every output file, e.g. sint
GENOME_FASTA = $koko/bin/sintGenome/sintGenome.fa # required: host reference, already bowtie2-indexed and samtools-faidx'd
SYMGENOME = $koko/bin/symGenomes/symMetaGenome.fasta # symbiont metagenome, already indexed; empty = host only
SYMGENUS = $koko/bin/symGenomes/symChrGenus # with SYMGENOME: chromosome<TAB>genus table
META = $koko/2bRAD/myProject/metadata.csv # required: sample metadata CSV, one row per sample
META_SAMPLE = sample     # column with the sample names (bam names without .bam)
META_GROUPS = bank depthZone # columns whose combination is a sampling group, e.g. site depth; empty = no group FST
EXTRA_READS =            # folder of extra <sample>.filtered.fastq.gz, already quality-filtered (e.g. published reads)
MIN_IND = 0.75           # proportion of samples an ANGSD site must have data in, for every analysis run ([depth] has its own)
SKIP =                   # steps to leave out: het theta groups fstall symbionts neutral kin outliers fst (check says what each changes)

# clones
TECHREPS = SGM027.1 SGM027.2 SGM027.3 SGM046.1 SGM046.2 SGM046.3 # technical replicates as <sample>.1 <sample>.2 ...; empty = set CLONE_CUT to a number
CLONE_METRIC = auto      # clone distance: auto (genotype distance when coverage supports it, else IBS), geno, ibs or both (geno, with IBS compared)
CLONE_CUT = auto         # auto (geno: widest gap just above the replicates; ibs: replicates' deepest join x TREE_BUFFER), gap, replicates, or a number
TREE_BUFFER = 1.10       # IBS cut: deepest join within any replicate set x this
CLONE_PAUSE = yes        # pause after the dendrogram; to go on set it to no (or set CLONE_CUT to a number) and run again
QDEPTH = 5               # depth for the sample-quality filters below (proportion of sites at >= QDEPTH x, from the depth step)
CLONE_MINQ = 0.20        # leave samples below this proportion out of the clone step (near-empty samples look close to everything; their genotype distances are unmeasurable)
CLONE_MAXDROP = 0.5      # stop if clone grouping would drop more than this proportion of the samples (a threshold or data problem)
MINQ = 0.25              # after clones: drop samples below this proportion

# structure and lineages
MAXK = 10                # NGSadmix K = 1..MAXK
ADMIX_REPS = 20          # NGSadmix replicates per K
K =                      # empty: pause at the K step to choose; a number: use that K
RESID_MAX = 0.01         # residual-block K: smallest K whose worst cluster-block mean |evalAdmix residual| is below this (a judgement call)
ASSIGN = 0.90            # ancestry needed to assign an individual to a lineage
MINPURE = 2              # fewest pure individuals a lineage may have
LINEAGE_MAXHET =         # within each lineage, remove sites heterozygous in more than this share of samples (e.g. 0.5: likely paralogs); empty = report only
KIN = 0.125              # NGSremix kinship at or above which one of a pair is dropped
MIN_GROUP = 5            # smallest lineage x sampling group kept for group FST (smaller ones are named in the diary)

# diversity
THETA_N =                # theta always from all pure individuals per lineage; a number or 'min' (smallest lineage) also gives theta from that many per lineage (Sub columns)

# ---- jobs: one section per job list. cpus and mem are per job (per array task);
# cpus is also the tool's own thread count (-P, --threads, -p) where it has one.
# queue (empty = [cluster] queue; 'long' = [cluster] long_queue) and slurm (extra
# sbatch flags, key=value) are optional in every section. args are the tool's
# options; in your config, args lists only changes to these (an option replaces the
# default's value or is added, '-option none' removes it). min_ind is ANGSD -minInd
# as a proportion of the samples in that run.

[cutadapt]               # quality trim, one job per sample
cpus = 1
mem = 4GB
# default args: -q 15,15 -m 36
args =                   # changes only: an option replaces the default's value, '-option none' removes it (comrad defaults popgen)

[map]                    # bowtie2, one job per sample (host and symbiont)
cpus = 1
mem =                    # empty = the bowtie2 index size x 1.5 + 2 GB
# default args: --no-unal --score-min L,16,1 --local -L 16
args =                   # changes only: an option replaces the default's value, '-option none' removes it (comrad defaults popgen)

[split]                  # host/symbiont split, scans and sorting
cpus = 1
mem = 8GB

[depth]                  # ANGSD depth pass and plotQC.py, one job each
cpus = 1
mem = 200GB
min_ind = 0.5            # the QC pass measures coverage, so it is looser than MIN_IND

[clones]                 # ANGSD IBS and genotype calls on every sample above CLONE_MINQ, one job; no per-sample depth floor (low-coverage samples still count, as in Matz's 2bRAD protocol)
cpus = 1
mem = 200GB
# default args: -uniqueOnly 1 -remove_bads 1 -minMapQ 20 -minQ 25 -dosnpstat 1 -doHWE 1 -sb_pval 1e-5 -skipTriallelic 1 -snp_pval 1e-5 -minMaf 0.05
args =                   # changes only: an option replaces the default's value, '-option none' removes it (comrad defaults popgen)
min_ind =                # empty = MIN_IND

[paralog]                # ngsParalog, one job per chunk of sites
cpus = 1
mem = 8GB
min_ind = 0.5            # ngsParalog -minind, as a proportion of the samples

[genotype]               # ANGSD on the kept samples, one job
cpus = 1
mem = 200GB
# default args: -uniqueOnly 1 -remove_bads 1 -minMapQ 20 -minQ 25 -dosnpstat 1 -doHWE 1 -sb_pval 1e-5 -hetbias_pval 1e-5 -skipTriallelic 1 -snp_pval 1e-5 -minMaf 0.05
args =                   # changes only: an option replaces the default's value, '-option none' removes it (comrad defaults popgen)
min_ind =                # empty = MIN_IND

[structure]              # PCAngsd (PCA and Fis)
cpus = 8
mem = 64GB

[admix]                  # NGSadmix, one job per K and replicate
cpus = 10
mem = 8GB

[evaladmix]              # evalAdmix, one job per K
cpus = 4
mem = 16GB

[kin]                    # NGSremix, one job
cpus = 8
mem = 100GB

[lineagesnps]            # ANGSD within each lineage
cpus = 1
mem = 32GB
# default args: -uniqueOnly 1 -remove_bads 1 -minMapQ 20 -minQ 25 -dosnpstat 1 -sb_pval 1e-5 -hetbias_pval 1e-5 -skipTriallelic 1 -snp_pval 1e-5 -minMaf 0.05
args =                   # changes only: an option replaces the default's value, '-option none' removes it (comrad defaults popgen)
min_ind =                # empty = MIN_IND

[selection]              # PCAngsd selection scan within each lineage
cpus = 8
mem = 64GB

[outliers]               # PCAngsd within each lineage, outliers removed
cpus = 8
mem = 64GB

[neutral]                # PCAngsd and NGSadmix on neutral, kin-free SNPs
cpus = 8
mem = 64GB

[sfssites]               # ANGSD site discovery for the SFS, per lineage
cpus = 1
mem = 64GB
# default args: -uniqueOnly 1 -remove_bads 1 -minMapQ 30 -minQ 30 -skipTriallelic 1 -sb_pval 1e-3 -hetbias_pval 1e-3
args =                   # changes only: an option replaces the default's value, '-option none' removes it (comrad defaults popgen)
min_ind =                # empty = MIN_IND

[saf]                    # ANGSD site allele frequencies (SFS, theta, FST): per lineage, full panel and sampling group
cpus = 1
mem = 32GB
# default args: -uniqueOnly 1 -remove_bads 1 -minMapQ 30 -minQ 30
args =                   # changes only: an option replaces the default's value, '-option none' removes it (comrad defaults popgen)

[fst]                    # realSFS 2D spectra and FST, per pair
cpus = 20
mem = 64GB

[het]                    # ANGSD + realSFS per sample on the SFS sites, for heterozygosity; 10x floor: one sample alone has no pooling to correct low-depth bias
cpus = 1
mem = 8GB
# default args: -uniqueOnly 1 -remove_bads 1 -minMapQ 30 -minQ 30 -setMinDepthInd 10
args =                   # changes only: an option replaces the default's value, '-option none' removes it (comrad defaults popgen)

[theta]                  # realSFS and thetaStat per lineage
cpus = 4
mem = 32GB
