# Example demography.config, in the same species folder, after popgen has FINISHED.
# Run:  comrad check demography && comrad run demography

SP = sint                # same prefix as popgen.config
MU = 2e-8                # required: mutation rate per site per generation, for scaled units
MODELS = SI SI2N IM IM2N IM2m IM2m2N IMa IMa2N AM AM2N AM2m AM2m2N SC SC2N SC2m SC2m2N IMghost SCghost
BOOT_JOBS = 25           # bootstrap jobs per pair, each with its own seed
BOOT_REPS = 4            # replicates per job (total = BOOT_JOBS x BOOT_REPS)
FIT_SEEDS = 5            # moments jobs per model, each with its own seed
FIT_RUNS = 10            # optimisations per job (total per model = FIT_SEEDS x FIT_RUNS)
MAXITER = 1000           # optimiser iterations per run
PROJECT =                # down-project every fit to N1 N2 haploid samples; empty = none

# ---- jobs: one section per job list. cpus and mem are per job (per array task);
# cpus is also the tool's own thread count. queue (empty = [cluster] queue;
# 'long' = [cluster] long_queue) and slurm (extra sbatch flags, key=value, e.g.
# constraint=amd) are optional in every section.

[boot]                   # realSFS contig bootstraps, BOOT_JOBS per pair
cpus = 20
mem = 8GB
queue = shortq7
slurm = constraint=amd

[moments]                # momentsModels.py, one job per model and seed; long runs
cpus = 4
mem = 32GB
queue = long
slurm = constraint=amd
