# Example cluster.config, in the project folder (here: one on FAU's KoKo).
# Every pipeline run in this folder, or up to three folders below it, reads it.
# Write a blank one with:  comrad init cluster

[cluster]
queue = shortq7          # most jobs (6 h limit there)
long_queue = longq7      # jobs that hit the time limit move here; sections with queue = long start here
max_mem = 250GB          # largest node memory: out-of-memory retries stop here
max_running = 64         # array tasks running at once, per job list
email = $EMAIL           # exported in ~/.bashrc
slurm =                  # e.g. constraint=amd to keep every job on the AMD nodes
driver_queue =           # empty = long_queue
driver_time =            # e.g. 2-00:00:00; empty = the partition maximum
driver_cpus = 8
driver_mem = 32GB
