# Example reads.config: one sequencing run holding two coral species.
# Run from the project folder:  comrad check reads && comrad run reads
# Write a blank one with  comrad init reads  or copy this one.

RAW = rawReads              # folder of raw pool fastqs, one per pool, named <pool>.fastq.gz (e.g. FG1-1.fastq.gz)
BS_PROJECTS =               # BaseSpace project ids to download into RAW; empty = the fastqs are already there
SAMPLE_SHEET = sampleID.csv # pool_barcode,sample per line, no header (see examples/sampleID.csv)
RENAME_ARGS =               # extra sampleRename.py options, e.g. --header if the sheet has one
# samples whose name starts with the prefix go to <species>/demuxReads; the same species
# name can repeat. Catch-all prefixes keep libraries with no sample name (empty wells,
# barcode errors) out of the way instead of stopping the species step.
SPECIES = sint=SGM past=PGM unassigned=FG
MIN_KEPT = 25               # stop if a pool keeps under 25% of its reads after dedup (2bRAD pools here ran 23-62%)

[download]
cpus = 1
mem = 200GB

[demux]
cpus = 2
mem = 16GB
# default args: --gzip
args =                      # changes only, e.g. --min-bc-count 50000; barcodes with < 100,000 reads (trim2bRAD.py's default) get no file
